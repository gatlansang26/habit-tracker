{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install",
      "type": "shell",
      "command": "pnpm install",
      "inAgents": true,
      "runOptions": { "runOn": "worktreeCreated" }
    },
    {
      "label": "Dev server",
      "type": "shell",
      "command": "pnpm dev",
      "inAgents": true
    },
    {
      "label": "Unit tests",
      "type": "shell",
      "command": "pnpm test",
      "inAgents": true
    },
    {
      "label": "E2E tests",
      "type": "shell",
      "command": "pnpm test:e2e",
      "inAgents": true
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "pnpm lint",
      "inAgents": true
    }
  ]
}
